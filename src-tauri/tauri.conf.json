{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoGo",
  "version": "0.2.0",
  "identifier": "com.haaschs.bogo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "BoGo",
        "width": 360,
        "height": 540,
        "minWidth": 260,
        "minHeight": 160,
        "x": 40,
        "y": 80,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://rts-overlay.github.io data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Haaschs",
    "copyright": "© 2026 Haaschs. Code sous licence MIT ; éléments d'Age of Empires IV © Microsoft (Game Content Usage Rules).",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1NUUzQzU4RTg1NDVBMzUKUldRMVdsVG9XRHhlOVErNUpLT09UQkpwWXhxZnBzMVdSV1RhSUM0SFF6RkFtdUdqK2Z0V0d0bngK",
      "endpoints": [
        "https://github.com/Haaschs-ae/BoGo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
